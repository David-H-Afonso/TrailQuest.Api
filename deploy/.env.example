# Public installation settings only. No account passwords or Garmin credentials.
# Copy to .env next to docker-compose.yml; never commit the filled file.
# Available after the first successful push workflow in both repositories.
# For pinned installs/rollback, select the tested sha-<full-commit> or @sha256 digest.
# Forks must replace the registry owner with their own lower-case GitHub owner.
TRAILQUEST_API_IMAGE=ghcr.io/david-h-afonso/trailquest-api:latest
TRAILQUEST_WEB_IMAGE=ghcr.io/david-h-afonso/trailquest-web:latest
TRAILQUEST_PUBLIC_HOST=trailquest.example.com
TRAILQUEST_PUBLIC_HTTPS_PORT=443
# Optional simultaneous LAN HTTP; keep the HTTPS public host above.
# Enable explicitly and set http://<literal-private-IP>:<published-web-port>.
TRAILQUEST_ALLOW_LAN_HTTP=false
TRAILQUEST_LAN_HTTP_ORIGIN=
# Exact immediate reverse-proxy peer observed by the web container. No CIDRs.
TRAILQUEST_TRUSTED_PROXY=REPLACE_WITH_EXACT_PROXY_IP
# Loopback by default. Choose a private interface reachable by your reverse proxy
# and restrict this HTTP port to that proxy; never publish the API port.
TRAILQUEST_BIND_ADDRESS=127.0.0.1
TRAILQUEST_HTTP_PORT=5223
TRAILQUEST_DATA_DIR=/DATA/AppData/trailquest/data
TRAILQUEST_SECURITY_DIR=/DATA/AppData/trailquest/security
TRAILQUEST_UID=1654
TRAILQUEST_GID=1654
TRAILQUEST_TIME_ZONE=Etc/UTC
TRAILQUEST_DEMO_ENABLED=false
# Illustrative PRIVATE Docker network; replace all three if it conflicts.
# These are installation settings, not baked-in IP addresses.
TRAILQUEST_SUBNET=172.30.52.0/29
TRAILQUEST_WEB_IP=172.30.52.2
TRAILQUEST_API_IP=172.30.52.3
