<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Local-first walking adventures with isolated demo data and Garmin Personal API support.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Garmin.FIT.Sdk" Version="21.221.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets Condition="'$(Configuration)' != 'Release'">runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <IncludeAssets Condition="'$(Configuration)' == 'Release'">build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;tools/**/*.cs" />
    <Content Remove="tests/**/*;tools/**/*" />
    <None Remove="tests/**/*;tools/**/*" />
    <Content Update="Content/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Installation settings and secrets are supplied at runtime, never published. -->
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
